{
  "manifest_version": 2,
  "id": "onlyfeather.rinne-tools",
  "version": "1.2.0",
  "name": "凛音的工具",
  "description": "让凛音在聊天中调用 NoneBot 的功能：画图、自拍、语音、投骰、Pixiv 搜图。功能由同一台服务器上的 NoneBot 执行，结果直接发到聊天里。",
  "author": {
    "name": "onlyfeather",
    "url": "https://github.com/onlyfeather"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/onlyfeather/myTest"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.10.0",
    "max_version": "2.16.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.24.0"
    }
  ],
  "plugin_type": "tool",
  "capabilities": ["message.get_by_id"],
  "i18n": {
    "default_locale": "zh-CN"
  }
}
